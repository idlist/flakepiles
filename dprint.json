{
  "lineWidth": 120,
  "typescript": {
    "semiColons": "asi",
    "quoteStyle": "alwaysSingle"
  },
  "json": {
  },
  "malva": {
    "printWidth": 80
  },
  "markup": {
  },
  "excludes": [
    "src/vue",
    "**/node_modules",
    "**/*-lock.json"
  ],
  "plugins": [
    "npm:@dprint/typescript@0.96.1",
    "npm:@dprint/json@0.25.2",
    "npm:dprint-plugin-malva@0.16.0",
    "npm:dprint-plugin-markup@0.27.5"
  ]
}
